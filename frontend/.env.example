# Leave empty when the backend serves this app (the default, same origin).
# Set it only for a split deployment, e.g. the frontend on Cloudflare Pages
# and the backend behind a tunnel. The backend must then list this app's
# origin in LUMINA_FRONTEND_ORIGIN so cookies and CORS work.
VITE_API_BASE=

# Where `npm run dev` proxies /api to.
LUMINA_API_TARGET=http://127.0.0.1:8787
