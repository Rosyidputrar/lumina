# Backend runs on the user's own device (free). Frontend on Cloudflare.

# ── Deployment split ─────────────────────────────────────────────────────────
# mode=device means the trading engine, vault and AI memory live in this
# process on the phone. No hosting bill, no third party holding your data.
LUMINA_DEPLOY=device

# The public URL of the Cloudflare-hosted frontend. Required for split
# deployment: it enables CORS and switches the session cookie to
# SameSite=None; Secure so the browser will send it cross-site.
# LUMINA_FRONTEND_ORIGIN=https://lumina.pages.dev

# The hostname Cloudflare Tunnel gives this device (no port forwarding needed).
# LUMINA_TUNNEL_HOSTNAME=lumina-api.example.com

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# Bind to 0.0.0.0 only if you are NOT using a tunnel and understand the exposure.
# HOST=0.0.0.0

# ── Licensing (replaces accounts entirely) ──────────────────────────────────
# Signs licence keys. MUST be 32+ random chars and MUST stay stable: rotating
# it invalidates every key already issued. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# With NODE_ENV=production the server refuses to start without it.
LUMINA_LICENSE_SECRET=

# Unlocks the owner console (sign in with "Owner" on the activation screen).
# If empty, owner access is disabled entirely.
LUMINA_OWNER_SECRET=

# Encrypts broker passwords at rest (AES-256-GCM). 32+ chars. Without it the
# broker-account form refuses to save rather than storing plaintext.
LUMINA_CREDENTIAL_SECRET=

# Metered operation costs, in quota units.
LUMINA_COST_CYCLE=3
LUMINA_COST_ASK=1
LUMINA_COST_BACKTEST=5

# ── Markets ──────────────────────────────────────────────────────────────────
# Without an MT5 gateway the watchlist defaults to public OKX/Kraken markets
# (BTC, ETH, SOL, EUR/USD, GBP/USD, PAXG gold). Override with a JSON array:
# LUMINA_WATCHLIST=[{"symbol":"BTC-USDT","venue":"okx","label":"Bitcoin / USDT","assetClass":"crypto"}]
# MT5 through mt5-gateway (docker compose --profile mt5). Inside compose the
# URL is http://mt5:5001; the key is the MT5_API_KEY from mt5-gateway.env.
# Symbol names are your broker's own: set them to what /symbols lists.
# MT5_GATEWAY_URL=http://mt5:5001
# MT5_GATEWAY_KEY=
# MT5_DEMO=1
# MT5_SYMBOL_EURUSD=EURUSD
# MT5_SYMBOL_GBPUSD=GBPUSD
# MT5_SYMBOL_XAUUSD=XAUUSD
# MT5_SYMBOL_US100=US100
# NEWS_FEED_URL=https://example.com/markets.rss

# ── Trading ──────────────────────────────────────────────────────────────────
LUMINA_AUTOTRADE=1
LUMINA_TIMEFRAME=1h
# Strategy profile: trend (default, trend-aligned with cost and stop rules) or
# classic (the original five playbooks without filters).
LUMINA_STRATEGY=trend
LUMINA_LOOP_MS=60000
LUMINA_EQUITY=10000
LUMINA_RISK_PER_TRADE=0.005
LUMINA_MAX_DAILY_LOSS=0.02
LUMINA_MAX_POSITIONS=3
LUMINA_MIN_CONFIDENCE=62
LUMINA_MIN_RR=1.6

# ── Live trading (off by default; needs both the flag and broker keys) ───────
# For MT5: LUMINA_LIVE=1 and LUMINA_BROKER=mt5, then the owner enables live in
# Settings. Test on a demo account first.
LUMINA_LIVE=0
LUMINA_BROKER=paper
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# ── Obsidian vault + AI memory (RAM only) ────────────────────────────────────
# These caps protect the device. The vault never touches disk.
LUMINA_VAULT_MAX_NOTES=400
LUMINA_VAULT_MAX_BYTES=4194304
LUMINA_VAULT_MAX_NOTE_BYTES=20480
LUMINA_VAULT_CONSOLIDATE_MS=300000
LUMINA_MEMORY_EPISODES=2000

# ── Shared files (APKs) — DISK, not RAM ──────────────────────────────────────
LUMINA_FILES=1
# LUMINA_FILES_DIR=./data/files
LUMINA_FILES_MAX_BYTES=314572800

# ── Analyst (optional) ───────────────────────────────────────────────────────
# Without a key the analyst runs a deterministic local reasoner. It is clearly
# labelled either way, and it always retrieves from the vault first.
# LUMINA_AI_KEY=
# LUMINA_AI_PROVIDER=claude
# LUMINA_AI_MODEL=claude-sonnet-5-5
