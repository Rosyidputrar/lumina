# Settings for the mt5 service in docker-compose.yml (copy to mt5-gateway.env).
# Variable names are those mt5-gateway reads; see its README for the full list.

# Login for the web desktop on 127.0.0.1:10004, where you sign into MT5 once.
CUSTOM_USER=lumina
PASSWORD=

# REQUIRED. The shared key every API call must carry (X-API-Key). Put the SAME
# value in backend/.env as MT5_GATEWAY_KEY. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MT5_API_KEY=

# REQUIRED. Your broker server's IANA time zone, so bar times convert to real
# UTC from the first request (Europe/Athens for most EET brokers, UTC for Exness).
BROKER_TIMEZONE=Europe/Athens

MT5_API_PORT=5001
LOG_LEVEL=INFO
